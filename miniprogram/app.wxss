page {
  color: #27394a;
  font-size: 28rpx;
  background:
    radial-gradient(circle at 18% 12%, rgba(80, 140, 220, 0.18), transparent 28%),
    radial-gradient(circle at 82% 16%, rgba(140, 80, 220, 0.12), transparent 26%),
    linear-gradient(135deg, #e4e8ee 0%, #f2f5f8 44%, #dde4ec 100%);
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.hero-card,
.card {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.38);
  box-shadow: 0 24rpx 64rpx rgba(80, 100, 160, 0.14), 0 44rpx 108rpx rgba(38, 58, 92, 0.12);
  backdrop-filter: blur(24rpx) saturate(180%);
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.3);
  box-shadow: 0 18rpx 44rpx rgba(80, 100, 160, 0.12), 0 32rpx 90rpx rgba(38, 58, 92, 0.12);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.brand-logo {
  width: 320rpx;
  height: 58rpx;
}

.brand-divider {
  width: 2rpx;
  height: 26rpx;
  background: rgba(24, 49, 74, 0.18);
}

.brand-system {
  color: #27394a;
  font-size: 22rpx;
  font-weight: 800;
}

.topbar-link {
  padding: 14rpx 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.56);
  border-radius: 999rpx;
  color: #385f7e;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.56);
}

.hero-card::before,
.card::before {
  position: absolute;
  inset: 0;
  content: "";
  pointer-events: none;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0.08) 46%, rgba(255, 248, 232, 0.42)),
    linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px),
    linear-gradient(0deg, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
  background-size: auto, 86rpx 86rpx, 86rpx 86rpx;
  opacity: 0.78;
}

.hero-card {
  padding: 34rpx 30rpx;
}

.hero-card-home {
  padding: 48rpx 34rpx 34rpx;
}

.hero-card-admin {
  padding: 42rpx 34rpx 30rpx;
}

.card {
  padding: 28rpx;
}

.brand-row,
.section-head,
.status-top,
.button-row {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 14rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 999rpx;
  color: #385f7e;
  background: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.title {
  position: relative;
  z-index: 1;
  margin-bottom: 12rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-title {
  position: relative;
  z-index: 1;
  margin-bottom: 16rpx;
  color: #27394a;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.14;
  text-align: center;
}

.hero-version {
  position: relative;
  z-index: 1;
  width: fit-content;
  margin: 0 auto 24rpx;
  padding: 12rpx 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #385f7e;
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title-admin {
  font-size: 54rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  margin: 0 0 28rpx;
  color: #758694;
  line-height: 1.7;
}

.subtitle {
  position: relative;
  z-index: 1;
  color: #758694;
  line-height: 1.7;
}

.version-chip {
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 244, 223, 0.72);
  color: #7a5a20;
  font-size: 22rpx;
  font-weight: 700;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.metric-badge {
  min-width: 160rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.44);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.42);
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(46, 78, 118, 0.08);
}

.metric-badge-compact {
  min-width: 190rpx;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #27394a;
}

.metric-label {
  margin-top: 6rpx;
  color: #758694;
  font-size: 22rpx;
}

.brand-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.28);
}

.brand-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 20rpx rgba(56, 95, 126, 0.12);
}

.brand-strip-copy {
  flex: 1;
  min-width: 0;
}

.brand-strip-title {
  margin-bottom: 6rpx;
  color: #27394a;
  font-size: 28rpx;
  font-weight: 800;
}

.field {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #385f7e;
  font-weight: 800;
  font-size: 22rpx;
}

.input,
.textarea {
  width: 100%;
  min-height: 74rpx;
  padding: 22rpx 26rpx;
  border: 2rpx solid rgba(116, 149, 181, 0.24);
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #27394a;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.56);
}

.picker-display {
  display: flex;
  align-items: center;
  color: #385f7e;
  font-weight: 700;
}

.textarea {
  border-radius: 22rpx;
  min-height: 280rpx;
}

.location-panel {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.44);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.52), rgba(255, 255, 255, 0.24));
}

.location-panel-home {
  padding-bottom: 16rpx;
}

.location-panel-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.location-meta {
  color: #758694;
  line-height: 1.6;
}

.map-preview {
  position: relative;
  height: 220rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(244, 248, 252, 0.96), rgba(255, 255, 255, 0.88));
}

.map-grid {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(140, 152, 166, 0.08) 1px, transparent 1px),
    linear-gradient(0deg, rgba(140, 152, 166, 0.08) 1px, transparent 1px);
  background-size: 44rpx 44rpx;
}

.map-cross {
  position: absolute;
  background: rgba(191, 199, 208, 0.36);
  border-radius: 999rpx;
}

.map-cross.one {
  left: -12rpx;
  right: -12rpx;
  top: 92rpx;
  height: 24rpx;
  transform: rotate(-9deg);
}

.map-cross.two {
  top: -10rpx;
  bottom: -10rpx;
  left: 240rpx;
  width: 24rpx;
  transform: rotate(18deg);
}

.map-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  margin-left: -17rpx;
  margin-top: -17rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  background: #385f7e;
  box-shadow: 0 0 0 16rpx rgba(80, 140, 220, 0.16);
}

.button-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.button-row button {
  flex: 1;
  min-width: 220rpx;
  margin: 0;
  border-radius: 999rpx;
  font-weight: 800;
  line-height: 2.6;
  box-shadow: 0 16rpx 30rpx rgba(39, 57, 74, 0.12);
}

.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2d4f6d 0%, #3f6f93 100%);
}

.secondary {
  color: #385f7e;
  background: rgba(255, 255, 255, 0.68);
}

.danger {
  color: #ffffff;
  background: linear-gradient(135deg, #8c2f2f 0%, #b84a4a 100%);
}

.stat-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat {
  padding: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.34);
}

.stat-label {
  color: #758694;
  font-size: 22rpx;
}

.stat-value {
  margin-top: 10rpx;
  color: #27394a;
  font-size: 36rpx;
  font-weight: 800;
}

.status-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-item {
  padding: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.28);
}

.status-item-compact {
  padding: 18rpx 20rpx;
}

.status-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.status-name {
  font-weight: 800;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.tag-ok {
  color: #0c8f61;
  background: rgba(12, 143, 97, 0.14);
}

.tag-pending {
  color: #9b2727;
  background: rgba(155, 39, 39, 0.12);
}

.muted {
  color: #758694;
  line-height: 1.6;
}

.history-count {
  color: #758694;
  font-size: 22rpx;
  font-weight: 800;
}

.history-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.history-item {
  padding: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.34);
}

.history-row-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.history-name {
  color: #27394a;
  font-weight: 800;
}

.history-time {
  color: #385f7e;
  font-size: 22rpx;
  font-weight: 700;
}

.feedback {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  line-height: 1.7;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 16rpx 34rpx rgba(46, 78, 118, 0.08);
}

.feedback-success {
  color: #0c8f61;
  background: rgba(255, 255, 255, 0.46);
}

.feedback-error {
  color: #9b2727;
  background: rgba(255, 255, 255, 0.46);
}

.link {
  color: #385f7e;
  font-weight: 800;
}

.admin-summary {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.admin-summary .stat {
  min-height: 132rpx;
}
